generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TripMemberRole {
  owner
  editor
  viewer
}

model Trip {
  id          String          @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  owner       User            @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TripMember[]
  items       ItineraryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@map("trip")
}

model TripMember {
  id        String         @id @default(cuid())
  tripId    String
  userId    String
  role      TripMemberRole
  position  Int            @default(0)
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_member")
}

model ItineraryItem {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  placeId   String?
  place     Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  startAt   DateTime?
  endAt     DateTime?
  done      Boolean   @default(false)
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tripId])
  @@index([placeId])
  @@map("itinerary_item")
}

enum PlaceCategory {
  food
  culture
  nature
  shopping
  nightlife
  attraction
}

enum PlaceLabel {
  popular
  hidden
  instagram
  skip
}

enum PriceBand {
  free
  low
  mid
  high
}

model Place {
  id           String          @id @default(cuid())
  cityId       String // add city table later
  osmId        String?         @unique // osm free map data
  name         String
  address      String?
  score        Float           @default(0) // 0-100 higher more must see
  scoreSource  String          @default("osm") // oms | ai | guide
  latitude     Float
  longitude    Float
  category     PlaceCategory
  labels       PlaceLabel[]    @default([])
  openingHours String?
  priceBand    PriceBand?
  indoor       Boolean?
  aiLabel      PlaceLabel?
  aiConfidence Float?
  verified     Boolean         @default(false)
  verifiedAt   DateTime?
  source       String          @default("osm") // osm, google, foursquare, ai
  items        ItineraryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, verified, category])
  @@index([cityId, category, score])
  @@map("place")
}

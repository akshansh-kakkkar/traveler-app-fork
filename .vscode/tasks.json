//* CTRL + SHIFT + B to run task
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "server: dev",
			"type": "shell",
			"command": "bun run dev:server",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"group": "dev"
			}
		},
		{
			"label": "native: dev",
			"type": "shell",
			"command": "bun run dev",
			"options": {
				"cwd": "${workspaceFolder}/apps/native"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"panel": "dedicated",
				"group": "dev"
			}
		},
		{
			"label": "dev: server + native",
			"dependsOn": ["server: dev", "native: dev"],
			"dependsOrder": "parallel",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
